        "logoUrl": { "type": "string" },
        "status": { "type": "string" },
        "termsAndConditions": { "type": "string" }
      }
    },
    "Vendor": {
      "title": "Vendor Master",
      "type": "object",
      "properties": {
        "vendorCode": { "type": "string" },
        "vendorName": { "type": "string" },
        "vendorType": { "type": "string" },
        "contactPerson": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" },
        "pincode": { "type": "string" },
        "gstNo": { "type": "string" },
