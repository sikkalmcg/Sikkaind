        "cnNumber": { "type": "string" },
        "cnDate": { "type": "string" },
        "dispatchDate": { "type": "string" },
        "ratePoint": { "type": "string" },
        "invoices": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "invNo": { "type": "string" },
              "ewaybillNo": { "type": "string" },
              "desc": { "type": "string" },
              "pkg": { "type": "number" },
              "uom": { "type": "string" }
            }
          }
        },
        "status": { "type": "string", "enum": ["LOADING", "IN-TRANSIT", "ARRIVED", "POD", "CLOSED", "REJECTION"] }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "MongoStore": {
    "/users/Sikkaind/plants/{plantId}": { "schema": "Plant", "description": "Plant master data." },
    "/users/Sikkaind/companies/{companyId}": { "schema": "Company", "description": "Company master data." },
    "/users/Sikkaind/vendors/{vendorId}": { "schema": "Vendor", "description": "Vendor master data." },
    "/users/Sikkaind/customers/{customerId}": { "schema": "Customer", "description": "Customer master data." },
    "/users/Sikkaind/sales_orders/{orderId}": { "schema": "SalesOrder", "description": "Sales order registry." },
    "/users/Sikkaind/trip_board/{tripId}": { "schema": "TripBoard", "description": "Trip execution board." },
    "/users/Sikkaind/users_master/{employeeId}": { "schema": "object", "description": "System access control." },
    "/users/Sikkaind/gps_tracking/{gpsId}": { "schema": "object", "description": "Live GPS node data." },
    "/users/Sikkaind/reports/{reportId}": { "schema": "object", "description": "System analytics reports." },
    "/users/Sikkaind/gps_tracking/settings": { "schema": "object", "description": "Global GPS UI settings." }
  }
}

