        "ifscCode": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Customer": {
      "title": "Customer Master",
      "type": "object",
      "properties": {
        "customerCode": { "type": "string" },
        "customerName": { "type": "string" },
        "customerType": { "type": "string" },
        "consignorName": { "type": "string" },
