
{
  "entities": {
    "Plant": {
      "title": "Plant Master",
      "type": "object",
      "properties": {
        "plantCode": { "type": "string" },
        "plantName": { "type": "string" },
        "plantType": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" },
        "pincode": { "type": "string" },
        "contactPerson": { "type": "string" },
        "contactNumber": { "type": "string" },
        "email": { "type": "string" },
        "gstNo": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Company": {
      "title": "Company Master",
      "type": "object",
      "properties": {
        "companyCode": { "type": "string" },
        "companyName": { "type": "string" },
        "companyShortName": { "type": "string" },
        "companyType": { "type": "string" },
        "linkedPlantCode": { "type": "string" },
        "gstNo": { "type": "string" },
        "panNo": { "type": "string" },
        "cinNo": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "logoUrl": { "type": "string" }
      }
    },
    "Vendor": {
      "title": "Vendor Master",
      "type": "object",
      "properties": {
        "vendorCode": { "type": "string" },
        "vendorName": { "type": "string" },
        "vendorType": { "type": "string" },
        "mobile": { "type": "string" },
        "address": { "type": "string" },
        "gstNo": { "type": "string" },
        "panNo": { "type": "string" },
        "paymentTerms": { "type": "string" }
      }
    },
    "Customer": {
      "title": "Customer Master",
      "type": "object",
      "properties": {
        "customerCode": { "type": "string" },
        "customerName": { "type": "string" },
        "customerType": { "type": "string" },
        "billingAddress": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "city": { "type": "string" },
        "gstNo": { "type": "string" },
        "mobile": { "type": "string" }
      }
    },
    "SalesOrder": {
      "title": "Sales Order",
      "type": "object",
      "properties": {
        "orderNo": { "type": "string" },
        "plantCode": { "type": "string" },
        "companyCode": { "type": "string" },
        "customerCode": { "type": "string" },
        "quantity": { "type": "number" },
        "uom": { "type": "string" },
        "orderDate": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "TripBoard": {
      "title": "Trip Board",
      "type": "object",
      "properties": {
        "tripNo": { "type": "string" },
        "orderNo": { "type": "string" },
        "vehicleNo": { "type": "string" },
        "transporterName": { "type": "string" },
        "driverMobile": { "type": "string" },
        "route": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "UserMaster": {
      "title": "User Registry",
      "type": "object",
      "properties": {
        "employeeCode": { "type": "string" },
        "employeeName": { "type": "string" },
        "username": { "type": "string" },
        "passwordEncrypted": { "type": "string" },
        "role": { "type": "string" },
        "tcodeAccess": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/Sikkaind/plants/{plantId}": { "schema": "Plant", "description": "Plant master data." },
    "/users/Sikkaind/companies/{companyId}": { "schema": "Company", "description": "Company master data." },
    "/users/Sikkaind/vendors/{vendorId}": { "schema": "Vendor", "description": "Vendor master data." },
    "/users/Sikkaind/customers/{customerId}": { "schema": "Customer", "description": "Customer master data." },
    "/users/Sikkaind/sales_orders/{orderId}": { "schema": "SalesOrder", "description": "Sales order registry." },
    "/users/Sikkaind/trip_board/{tripId}": { "schema": "TripBoard", "description": "Trip execution board." },
    "/users/Sikkaind/users_master/{employeeId}": { "schema": "UserMaster", "description": "System access control." },
    "/users/Sikkaind/gps_tracking/{gpsId}": { "schema": "object", "description": "Live GPS node data." },
    "/users/Sikkaind/shipments/{shipId}": { "schema": "object", "description": "Shipment tracking nodes." },
    "/users/Sikkaind/reports/{reportId}": { "schema": "object", "description": "System analytics reports." }
  }
}
