rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() { return request.auth != null; }

    // 1. PUBLIC EXECUTION NODES (Tracking & Document Preview)
    match /public_trips/{tripId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /public_orders/{orderNo} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 2. SIKKAIND HUB - PUBLIC READ FOR LOGISTICS
    // Explicitly allow public read for execution data to support tracking and unauthenticated print previews
    match /users/Sikkaind/trip_board/{id} { allow read: if true; }
    match /users/Sikkaind/companies/{id} { allow read: if true; }
    match /users/Sikkaind/customers/{id} { allow read: if true; }
    match /users/Sikkaind/sales_orders/{id} { allow read: if true; }
    match /users/Sikkaind/plants/{id} { allow read: if true; }
    match /users/Sikkaind/vendors/{id} { allow read: if true; }

    // Protected administrative data (Users Master)
    match /users/Sikkaind/users_master/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // Default catch-all for Sikkaind write operations
    match /users/Sikkaind/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // 3. PRIVATE USER REGISTRY
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /user_profiles/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /user_registry/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // 4. GLOBAL CATCH-ALL
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}