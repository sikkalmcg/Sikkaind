rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() { return request.auth != null; }

    // 1. PUBLIC EXECUTION NODES (Tracking & Document Preview)
    // These paths allow unauthenticated customers to view movement and documentation.
    match /public_trips/{tripId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /public_orders/{orderNo} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 2. PROTECTED SYSTEM HUB (Sikkaind)
    // All administrative master data and logs require authentication.
    match /users/Sikkaind/{allPaths=**} {
      allow read, write: if isSignedIn();
    }
    
    // 3. PRIVATE USER REGISTRY
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /user_profiles/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /user_registry/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // 4. GLOBAL CATCH-ALL
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}